# Sentinel Environment Configuration
# Copy this to .env and fill in your values

# Environment
ENVIRONMENT=localdev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel

# LLM Gateway
AI_GATEWAY_URL=http://localhost:4000

# LLM Models (via LiteLLM)
ALERT_CLASSIFIER_LLM=openai/gpt-4.1-mini
ROOT_CAUSE_LLM=openai/gpt-4.1
TICKET_REVIEWER_LLM=openai/gpt-4.1-mini
RESPONSE_DRAFTER_LLM=openai/gpt-4.1

# SRE - PagerDuty
PAGERDUTY_API_KEY=

# SRE - Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# SRE - HolmesGPT
HOLMESGPT_ENABLED=true

# Support - Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# Support - Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# Search Backend
DOCUMENT_SEARCHER=bedrock_knowledge_base

# Feature Flags
SRE_AUTO_INVESTIGATE=true
SUPPORT_AUTO_DRAFT=true

# Slack
SLACK_BOT_TOKEN=
SRE_SLACK_CHANNEL=
SUPPORT_SLACK_CHANNEL=

# Observability
DD_ENV=localdev
