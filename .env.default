# Sentinel Environment Configuration
# Copy this to .env and fill in your values

# Environment
ENVIRONMENT=localdev
# asyncpg falls back to the OS user when the URL omits the role. On macOS
# Homebrew Postgres that's already a superuser; the `db` compose service runs
# trust auth so any role connects without a password. Set PGUSER in your shell
# (or in docker-compose for service containers) when the OS user has no role.
DATABASE_URL=postgresql+asyncpg://localhost:5432/sentinel

# LangGraph checkpointer DSN. Unset = defaults to DATABASE_URL with the
# SQLAlchemy "+asyncpg" driver suffix stripped (langgraph-checkpoint-postgres
# uses psycopg under the hood, which speaks plain libpq URLs).
LANGGRAPH_CHECKPOINT_DSN=

# Foundations — team profile selects the active config in get_config() dispatch.
# Only "sre" is wired today; "devops"/"ace" raise NotImplementedError until their
# entries land in TEAM_CONFIG_REFS.
TEAM_PROFILE=sre

# LiteLLM proxy (RFC §2.4, ADR 0007).
#
# When LITELLM_BASE_URL is unset (local dev): every PydanticAI agent falls
# back to the in-process LiteLLM SDK and reaches provider APIs directly using
# the provider's own env vars (e.g. OPENAI_API_KEY). This is the
# `just run-api` path — no proxy infrastructure required.
#
# When LITELLM_BASE_URL is set (staging / production): every PydanticAI agent
# routes through the firm-shared LiteLLM proxy. Outbound model calls hit
# `${LITELLM_BASE_URL}` with `Authorization: Bearer ${LITELLM_VIRTUAL_KEY}`,
# the proxy enforces tenant routing + rate limits, and direct egress to
# provider endpoints (api.openai.com, api.anthropic.com, …) is blocked at
# the network layer (R-OB-1, full enforcement deferred to wk5 Helm work).
#
# Both values must be set together. Setting one without the other is treated
# as unconfigured and emits the `litellm_proxy_partial_config` warning.
LITELLM_BASE_URL=
LITELLM_VIRTUAL_KEY=

# Langfuse (local self-hosted via docker-compose)
# Defaults target the Langfuse v3 stack from docker-compose.yml
# (langfuse-web exposed on host port 3001 with seeded dev keys).
# Leave host blank to fall back to the OTel console exporter.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-localdev
LANGFUSE_SECRET_KEY=sk-lf-localdev

# Firm-shared OTel collector endpoint (separate from the signal-specific
# OTEL_TRACES_ENDPOINT below).
OTEL_COLLECTOR_ENDPOINT=

# Runbook root — loader resolves team-specific subdirectories from this path.
RUNBOOKS_ROOT=src/sentinel/domain/runbooks

# Ollama (for local model serving)
OLLAMA_BASE_URL=http://localhost:11434

# LLM Models (provider/model format)
ALERT_CLASSIFIER_LLM=openai/gpt-4.1-mini
ROOT_CAUSE_LLM=openai/gpt-4.1
TICKET_REVIEWER_LLM=openai/gpt-4.1-mini
RESPONSE_DRAFTER_LLM=openai/gpt-4.1

# Stage 2 runbook disambiguator (F6). Used on Stage 1 ties and zero-match
# rescue. Empty = fall back to ALERT_CLASSIFIER_LLM. A small fast model
# (e.g. ollama/qwen3:4b) is appropriate.
RUNBOOK_DISAMBIGUATOR_LLM=

# Stage 3 RAG fallback (F6.J). Disabled by default — when True, a Stage 2B
# no-match result triggers pgvector retrieval against pre-indexed runbook
# embeddings. The application-layer reindex daemon walks the catalog at
# startup only when this flag is True.
RUNBOOK_RAG_FALLBACK_ENABLED=false

# F6.J embedder model. Provider/model format. The runbook_embeddings table
# is dimension-locked at 1536 (v1 spec) — keep the model output dimension
# aligned. text-embedding-3-small is the firm-default; swap to a 1536-d
# Ollama model to keep the embedder in-process for local dev.
RUNBOOK_EMBEDDER_LLM=openai/text-embedding-3-small

# F6.J Stage 3 cosine-similarity threshold. Candidates below this score are
# dropped — the matcher prefers a no-match over a noisy near-miss because
# the generic playbook + approval gate are the safer downstream path.
RUNBOOK_RAG_MIN_SIMILARITY=0.78

# F6.J Stage 3 top-k retrieval depth. Five gives enough recall to write a
# useful evidence trail without inflating runbook_rag_match_evidence rows.
RUNBOOK_RAG_TOP_K=5

# SRE - PagerDuty
PAGERDUTY_API_KEY=

# Observability backend: "datadog" | "grafana" | "" (auto: grafana for localdev, datadog for production)
OBSERVABILITY_BACKEND=

# Datadog (when OBSERVABILITY_BACKEND=datadog)
DATADOG_API_KEY=
DATADOG_APP_KEY=

# Grafana stack (when OBSERVABILITY_BACKEND=grafana — auto-selected for localdev)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=
GRAFANA_PROMETHEUS_DATASOURCE_UID=prometheus
GRAFANA_LOKI_DATASOURCE_UID=loki
GRAFANA_TEMPO_DATASOURCE_UID=tempo

# SRE - HolmesGPT
# When HOLMES_BACKEND=sdk, Holmes auto-wires its built-in Confluence and Notion
# toolsets from CONFLUENCE_BASE_URL + JIRA_USER_EMAIL + JIRA_API_TOKEN and
# NOTION_TOKEN respectively — each toolset is skipped when its settings are blank.
HOLMESGPT_ENABLED=true
HOLMES_BACKEND=sdk           # "direct" (vendor adapters) or "sdk" (HolmesGPT ToolCallingLLM)
HOLMES_SDK_MODEL=openai/gpt-4.1

# Support - Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# Support - Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# Support - Notion (used by HolmesGPT Notion toolset when HOLMES_BACKEND=sdk)
NOTION_TOKEN=

# Search Backend
DOCUMENT_SEARCHER=bedrock_knowledge_base

# Feature Flags
SRE_AUTO_INVESTIGATE=true
SUPPORT_AUTO_DRAFT=true
# W2 feature flag: set to true to route SRE investigations through the
# LangGraph workflow (interfaces/workflows/sre_investigation.py) instead
# of the legacy Pydantic Graph pipeline. Keep false until LangGraph SRE
# migration (langgraph-sre-migration.md) is complete.
LANGGRAPH_SRE_ENABLED=false

# Slack
SLACK_BOT_TOKEN=
SRE_SLACK_CHANNEL=
SUPPORT_SLACK_CHANNEL=

# Observability
DD_ENV=localdev

# OpenTelemetry / Metrics
OTEL_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=sentinel
WORKER_METRICS_PORT=8001

# MCP Servers — shared toolsets injected into every non-router pipeline agent.
# JSON array of server objects. Omit or leave empty to disable shared MCP injection.
# Servers connect lazily; unreachable servers do not block agent runs.
#
# HTTP (SSE) server example — Datadog MCP:
# MCP_SERVERS=[{"name": "datadog", "url": "http://localhost:9090/sse"}]
#
# HTTP (SSE) server example — GitHub MCP:
# MCP_SERVERS=[{"name": "github", "url": "http://localhost:9091/sse"}]
#
# Stdio server example — Confluence MCP:
# MCP_SERVERS=[{"name": "confluence", "command": "npx", "args": ["-y", "@confluence/mcp"]}]
#
# Multiple servers (mixed):
# MCP_SERVERS=[{"name": "datadog", "url": "http://localhost:9090/sse"}, {"name": "confluence", "command": "npx", "args": ["-y", "@confluence/mcp"]}]
MCP_SERVERS=

# K8s MCP server — optional kubectl MCP for K8s agent extended operations:
# K8S_MCP_SERVER_URL=http://localhost:9090/sse
K8S_MCP_SERVER_URL=

# MCP Server — Sentinel's own MCP server for external agents
MCP_SERVER_PORT=8811
MCP_SERVER_API_KEY=

# K8s Investigation Agent
# Backend: "native" (PydanticAI agent), "kagent" (CRD delegation), "both" (A/B comparison), "" (disabled)
K8S_INVESTIGATION_BACKEND=
K8S_INVESTIGATOR_LLM=ollama/qwen3-coder:30b
K8S_CLUSTER_NAME=
K8S_DEFAULT_NAMESPACE=

# Kagent (CRD-based K8s investigation)
KAGENT_INVESTIGATION_TIMEOUT_SECONDS=120
KAGENT_NAMESPACE=kagent-system

# Challenger adapter for A/B comparison mode ("native_k8s", "kagent", or "" disabled)
CHALLENGER_ADAPTER=

# Identity envelope (RFC §3.1, F2)
# Region label carried on every Envelope.region; falls back to "unknown" when blank.
REGION=
# When True, webhook ingress hard-fails with HTTP 422 if tenant_id cannot be
# derived from the request payload (R-IN-3). Foundations default is soft-fail
# (warns + falls back to tenant_id="unknown"); production deploys flip to True.
ENVELOPE_STRICT_MODE=false
